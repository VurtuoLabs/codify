            <invocationTargetType>flow</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
            <localDeveloperName>tag_root_cause</localDeveloperName>
            <masterLabel>Tag Root Cause</masterLabel>
            <progressIndicatorMessage>Working out what caused it...</progressIndicatorMessage>
        </localActions>
