<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The object's default layout, replaced in place (see the Resolution Log layout
  for why the name matters). No relatedLists block here on purpose: nothing in
  this project looks up to Codify_Change_Log__c, so it has no child
  relationships and there is no related list to draw. Its own record page shows
  the change and links back up to the recap instead.
-->
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>What changed</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Change_Type__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Object_API_Name__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Related_Record_Name__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Field_Name__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Requires_Human_Review__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Related_Record_Id__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Before and after</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Old_Value__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>New_Value__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Where this came from</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Source_Resolution_Log__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Created_By_Technician__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Name</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
</Layout>
