<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The Messaging for In-App and Web channel Codify runs on.

  Codify is deployed over MIAW rather than as an internal Agentforce chat because
  the people who know how a Case was actually fixed frequently do not hold a full
  Salesforce licence: field technicians, franchise partners and contracted service
  providers typically only have Experience Cloud access. MIAW reaches them where
  they already are.

  sessionHandlerType is Router rather than Flow or Queue on purpose. A resolution
  recap is a single synchronous exchange between a technician and the agent, so
  there is no human queue to route to and nothing to hand off; routing to an
  omni-channel queue would put a person in the middle of a conversation that does
  not need one.
-->
<MessagingChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Codify</masterLabel>
    <messagingChannelType>EmbeddedMessaging</messagingChannelType>
    <!--
      Sessions hand off to the Support Ops queue rather than to a routing flow.
      A resolution recap is a single synchronous exchange with the agent, so
      there is no work to distribute; the queue exists for the exception, a
      technician who asks for a person, not for the normal path.
    -->
    <sessionHandlerType>Queue</sessionHandlerType>
    <sessionHandlerQueue>Codify_Support_Ops</sessionHandlerQueue>

    <automatedResponses>
        <autoResponseContentType>TextResponse</autoResponseContentType>
        <language>en_US</language>
        <response
    >No problem, you can close this any time. Anything you already described has been saved.</response>
        <type>OptOutConfirmation</type>
    </automatedResponses>
    <automatedResponses>
        <autoResponseContentType>TextResponse</autoResponseContentType>
        <language>en_US</language>
        <response
    >Just tell me how you fixed the issue in your own words. Type STOP to end the session.</response>
        <type>HelpResponse</type>
    </automatedResponses>

    <messagingKeywords>
        <keyword>cancel</keyword>
        <keyword>end</keyword>
        <keyword>quit</keyword>
        <keyword>stop</keyword>
        <keyword>stopall</keyword>
        <keyword>unsubscribe</keyword>
        <keywordType>OptOut</keywordType>
        <language>en_US</language>
    </messagingKeywords>
    <messagingKeywords>
        <keyword>help</keyword>
        <keywordType>Help</keywordType>
        <language>en_US</language>
    </messagingKeywords>

    <!--
      Pre-chat context. The Case id arrives from the host page when Codify is
      launched from a Case detail component, which is why the agent never has to
      open with "which case are you closing?". The subject rides along so the
      welcome panel can show the technician what they are about to close and
      they can catch a wrong launch before dictating anything.
    -->
    <standardParameters>
        <parameterType>Subject</parameterType>
    </standardParameters>
    <standardParameters>
        <parameterType>FirstName</parameterType>
    </standardParameters>
    <standardParameters>
        <parameterType>LastName</parameterType>
    </standardParameters>
    <standardParameters>
        <parameterType>Email</parameterType>
    </standardParameters>
</MessagingChannel>
