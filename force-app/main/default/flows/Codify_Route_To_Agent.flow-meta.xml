<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The Omni-Channel routing flow that puts the Codify agent into the conversation.

  This is what the MIAW channel's session handler points at. Without it the
  session opens, the technician's message shows as "Sent", and nothing ever
  answers: routing a messaging session to a QUEUE waits for a human to accept it,
  and there is no human on the other end of Codify.

  routingType is Bot and botId is the Codify agent, so the session is handed
  straight to the agent rather than queued. The queue is still supplied because
  routeWork requires a fallback target for the case where the bot cannot take the
  work; that fallback is Codify Support Ops, the same people who pick up
  escalations.

  NOTE: routeWork takes literal record ids, not developer names, so botId,
  queueId and serviceChannelId below are specific to this org. Re-point them when
  deploying elsewhere; the README lists the queries that produce them.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description
  >Routes an incoming Codify messaging session directly to the Codify Agentforce agent.</description>
    <environments>Default</environments>
    <interviewLabel
  >Codify Route To Agent {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Codify Route To Agent</label>
    <processType>RoutingFlow</processType>
    <status>Active</status>

    <recordLookups>
        <name>Get_Messaging_Session</name>
        <label>Get Messaging Session</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Route_To_Codify</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>MessagingSession</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <actionCalls>
        <name>Route_To_Codify</name>
        <label>Route To Codify</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <actionName>routeWork</actionName>
        <actionType>routeWork</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>routeWork</nameSegment>
        <offset>0</offset>
        <inputParameters>
            <name>recordId</name>
            <value><elementReference>recordId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>serviceChannelId</name>
            <value><stringValue>0N9fj0000041XFlCAM</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>serviceChannelLabel</name>
            <value><stringValue>Messaging</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>serviceChannelDevName</name>
            <value><stringValue>sfdc_livemessage</stringValue></value>
        </inputParameters>
        <!-- Bot, not Queue. This is the whole point of the flow. -->
        <inputParameters>
            <name>routingType</name>
            <value><stringValue>Bot</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>botId</name>
            <value><stringValue>0Xxfj000002qQbZCAU</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>botLabel</name>
            <value><stringValue>Codify</stringValue></value>
        </inputParameters>
        <!-- Fallback target if the agent cannot take the work. -->
        <inputParameters>
            <name>queueId</name>
            <value><stringValue>00Gfj00000EgOc9EAF</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>queueLabel</name>
            <value><stringValue>Codify Support Ops</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>isQueueVariable</name>
            <value><booleanValue>false</booleanValue></value>
        </inputParameters>
        <inputParameters><name>routingConfigId</name></inputParameters>
        <inputParameters><name>routingConfigLabel</name></inputParameters>
        <inputParameters><name>agentId</name></inputParameters>
        <inputParameters><name>agentLabel</name></inputParameters>
        <inputParameters><name>skillOption</name></inputParameters>
        <inputParameters><name
      >skillRequirementsResourceItem</name></inputParameters>
    </actionCalls>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference
      >Get_Messaging_Session</targetReference></connector>
    </start>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
