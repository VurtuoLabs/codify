# List files or directories below to ignore them when running prettier
# More information: https://prettier.io/docs/en/ignore.html
#

**/staticresources/**
.localdevserver
.sfdx
.sf
.vscode

coverage/
# prettier-plugin-xml hands <flow> element content to its JavaScript-Flow parser,
# which appends a stray ';' and breaks the value. Permission sets are the only
# metadata here that carry <flow> elements, so they are formatted by hand.
**/permissionsets/**

# Generated by `sf agent publish` from the .agent source. Committed as the record
# of the published version, but not hand-edited, so not formatted.
**/genAiPlannerBundles/**
**/bots/**

# Retrieved Experience Cloud metadata. Kept byte-for-byte as the org returned it
# so re-retrieves produce clean diffs rather than formatting churn.
**/digitalExperiences/**
